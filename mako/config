# Posição e Tamanho
anchor=top-center
margin=20
width=350
padding=15

# Fonte e Estética
font=JetBrainsMono Nerd Font 11
background-color=#1e1e2ecc
text-color=#ffffff
border-size=1
border-radius=8

# Comportamento
default-timeout=5000
ignore-timeout=1

# Cores baseadas na urgência do notify-send
[urgency=low]
border-color=#ffffff

[urgency=normal]
border-color=#00f2ff

[urgency=critical]
border-color=#ff5555
background-color=#330000CC
default-timeout=0
