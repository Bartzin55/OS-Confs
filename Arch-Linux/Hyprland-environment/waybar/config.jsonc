{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-left": 5,
    "margin-right": 5,
	"margin-top": 1,
	
    "modules-left": [
        "hyprland/workspaces",
        "custom/separator",
        "custom/weather",
        "custom/verticalseparator",
        "clock",
        "custom/separator",
        "tray"
    ],

/*    "modules-center": [
    ],*/

    "modules-right": [
    	"custom/menu",
        "custom/separator",
        "network#speed",
		"custom/verticalseparator",
        "custom/procs",
        "custom/verticalseparator",
        "memory",
        "custom/verticalseparator",
        "temperature",
        "custom/verticalseparator",
        "cpu",
        "custom/separator",
        "custom/usb",
        "bluetooth",
        "custom/network",
        "pulseaudio",
        "custom/battery"
    ],

    // --- ESQUERDA ---   
    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true,
    },
    "tray": {
    	"icon-size": 16,
        "spacing": 10
    },

	"clock": {
	    "interval": 1,
	    "format": "{:%a - %d/%m/%Y - %H:%M:%S}",
	    "tooltip-format": "<tt><small>{calendar}</small></tt>",
	    "calendar": {
	        "mode": "month",
	        "on-scroll": 1,
	        "format": {
	            "months": "<span color='#ffead3'><b>{}</b></span>",
	            "days": "<span color='#ecc6d9'><b>{}</b></span>",
	            "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
	            "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
	            "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
	        }
	    },
	    "actions": {
	        "on-scroll-up": "shift_up",
	        "on-scroll-down": "shift_down"
	    }
	},

	"custom/weather": {
	    "exec": "~/.config/waybar/scripts/weather.sh",
	    "return-type": "json",
	    "format": " {}",
	    "interval": 300
	},

    // --- DIREITA ---
    "cpu": {
        "interval": 2,
        "format": "{usage}%  ",
		"min-length": 7,
		"max-length": 7,
        "states": {
            "critical": 90
    	},
    	"on-click": "alacritty -e htop"
    },
    
    "memory": {
        "interval": 2,
        "format": "{percentage}% ",
        "states": {
            "critical": 90
        },
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB",
        "on-click": "alacritty -e htop",
        "min-length": 7,
        "max-length": 7
    },

	"temperature": {
	    "interval": 5,
	    "critical-threshold": 90,
	    "thermal-zone": 7,
	    "format": "{temperatureC}°C {icon}",
	    "format-icons": ["", "", ""],
	    "tooltip": false,
	    "min-length": 7,
	    "max-length": 7
	},

	"custom/procs": {
    	"interval": 5,
    	"format": "{} ",
    	"exec": "ps aux | wc -l",
    	"tooltip-format": "Total number of processes in the system",
    	"on-click": "alacritty -e htop",
		"min-length": 7,
		"max-length": 7
	},

	"custom/usb": {
    	"exec": "~/.config/waybar/scripts/usb.sh",
    	"return-type": "json",
    	"interval": 2,
    	"format": "{}",
    	"on-click": "~/.config/waybar/scripts/usb_menu.sh",
    	"min-length": 3,
    	"max-length": 3
	},
    "bluetooth": {
        "format-on": "",
        "format-off": "",
        "format-connected": "({num_connections})󰂱",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectado(s)",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
		"on-click": "alacritty -e bluetuith",
		"min-length": 6,
	   	"max-length": 6
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/internet-check.sh",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "on-click": "alacritty -e nmtui",
        "min-length": 2,
	   	"max-length": 2
    },

	"network#speed": {
    	"interval": 3,
    	"format": "{bandwidthDownBits}  - {bandwidthUpBits} ",
    	"tooltip-format": "Download | Upload",
    	"min-length": 24,
	   	"max-length": 24,
    	"align": 0.5
	},

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 Muted",
        "tooltip-format": "Volume: {volume}%\nSaída: {desc}",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "alacritty -e pulsemixer",
		"states": {
        	"overamplified": 101,
    	},
        "min-length": 6,
	   	"max-length": 6    	
    },
    
	"custom/battery": {
	        "exec": "~/.config/waybar/scripts/battery.sh",
	        "return-type": "json",
	        "interval": 5,
	        "format": "{}",
	        "on-click": "powerprofilesctl set $([ $(powerprofilesctl get) = 'power-saver' ] && echo 'balanced' || ([ $(powerprofilesctl get) = 'balanced' ] && echo 'performance' || echo 'power-saver')) && pkill -RTMIN+8 waybar",
	        "signal": 8
    },

    "custom/menu": {
    	"format": "󰍜",
    	"on-click": "~/.config/wofi/settings-menu.sh",
    	"tooltip-format": "Settings"
    },

// Separador (visual)
	"custom/separator": {
	    "format": "|",
	    "interval": "once",
	    "tooltip": false
	},

	"custom/verticalseparator": {
	    "format": "|",
	    "interval": "once",
	    "tooltip": false
	},
}
